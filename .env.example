# Optional API key for the generation provider added in a later phase.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
RAG_GENERATION_PROVIDER=auto

# Local embedding model used by the embedding pipeline.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval defaults. These will be consumed when retrieval is implemented.
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.50
RAG_CANDIDATE_K=20
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_INDEX_DIRECTORY=data/processed
